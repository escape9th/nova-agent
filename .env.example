# Nova agent framework — environment configuration.
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# The `.env` file is git-ignored: NEVER commit real keys.

# Any OpenAI-compatible provider works. Pick one base_url:
#   OpenAI        -> https://api.openai.com/v1
#   Aliyun Bailian (Qwen) -> https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek      -> https://api.deepseek.com/v1
#   Moonshot      -> https://api.moonshot.cn/v1
NOVA_API_KEY=sk-xxx
NOVA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NOVA_MODEL=qwen-plus

# Optional: embedding model used by long-term memory.
# Leave empty to fall back to the local hashing embedder (no API call needed).
NOVA_EMBED_MODEL=text-embedding-v3
